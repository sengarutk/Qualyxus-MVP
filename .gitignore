# Local Virtual Environments & Dependency Trees
.venv/
venv/
ENV/

# IDE Configuration Caches (Prevents workspace editor noise)
.idea/
.vscode/

# Python Runtime Bytecode Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Core Machine Learning Binary Weights (Dynamic)
# Patterns are anchored to the repository root so that source packages such as
# src/data/ are never swallowed by the runtime data directory rules.
/models/
/runs/
*.pt
*.onnx
*.engine

# Metrology Storage, Simulation Artifacts, & CSV Telemetry Databases
/data/
/reports/
*.db
*.db-wal
*.db-shm
*.csv

# Local environment secrets
.env
/secrets/
