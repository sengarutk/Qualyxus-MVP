[Unit]
Description=Qualyxus inspection runtime
After=network-online.target
Wants=network-online.target

[Service]
User=qualyxus
Group=qualyxus
WorkingDirectory=/opt/qualyxus
Environment=CONFIG_PATH=/etc/qualyxus/config.yaml PYTHONPATH=/opt/qualyxus HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 QUALYXUS_LOG_FORMAT=json
EnvironmentFile=-/etc/qualyxus/environment
ExecStart=/opt/qualyxus/.venv/bin/python main.py
Restart=always
RestartSec=5
# Parts in inspection get their verdict and the PLC is cleared before this runs out.
KillSignal=SIGINT
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/qualyxus
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
